# Telegram
TELEGRAM_BOT_TOKEN=
# IDs numericos, separados por virgula. Com a lista vazia, ninguem consulta.
TELEGRAM_ALLOWED_USER_IDS=
# false permite salvar/encaminhar o PDF; true ativa a protecao de conteudo do Telegram.
TELEGRAM_PROTECT_CONTENT=false
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Promobank
PROMOBANK_BASE_URL=https://promobank.online/
PROMOBANK_COMPANY=
PROMOBANK_USERNAME=
PROMOBANK_PASSWORD=

# Opcional. Vazio usa %LOCALAPPDATA%\PromobankTelegramBot\chrome-profile.
# Nao abra o perfil exclusivo do robo manualmente enquanto o bot estiver ativo.
PROMOBANK_PROFILE_DIR=
PROMOBANK_CHROME_CHANNEL=chrome
# Opcional: caminho absoluto do chrome.exe. Quando informado, substitui o canal acima.
PROMOBANK_CHROME_EXECUTABLE=
PROMOBANK_HEADLESS=false

# Limites operacionais
PROMOBANK_LOGIN_TIMEOUT_MS=60000
PROMOBANK_QUERY_TIMEOUT_MS=120000
PROMOBANK_PDF_TIMEOUT_MS=60000
PROMOBANK_MAX_PDF_BYTES=52428800
QUEUE_MAX_PENDING=50
LOG_LEVEL=info
