# WhatsApp vinculado
WHATSAPP_GROUP_NAME=TESTE PROMOBANK
# O padrao guarda a sessao fora do OneDrive. Informe apenas se precisar mudar.
WHATSAPP_SESSION_DIR=

# Promobank
PROMOBANK_BASE_URL=https://promobank.online/
PROMOBANK_COMPANY=
PROMOBANK_USERNAME=
PROMOBANK_PASSWORD=

# Opcional. Vazio usa %LOCALAPPDATA%\PromobankTelegramBot\chrome-profile.
# Nao abra o perfil exclusivo do robo manualmente enquanto o bot estiver ativo.
PROMOBANK_PROFILE_DIR=
PROMOBANK_CHROME_CHANNEL=chrome
# Opcional: caminho absoluto do chrome.exe. Vazio usa o Chrome instalado.
PROMOBANK_CHROME_EXECUTABLE=
# Porta local usada pelo Chrome dedicado. O padrao e 9223.
PROMOBANK_DEBUG_PORT=9223
# Opcional. Vazio usa %LOCALAPPDATA%\PromobankWhatsAppBot\pdf-cache.
# O arquivo e apagado apos o envio ao solicitante.
PROMOBANK_PDF_DIR=
PROMOBANK_HEADLESS=false

# Limites operacionais
PROMOBANK_LOGIN_TIMEOUT_MS=60000
PROMOBANK_QUERY_TIMEOUT_MS=120000
PROMOBANK_PDF_TIMEOUT_MS=60000
PROMOBANK_MAX_PDF_BYTES=52428800
QUEUE_MAX_PENDING=50
LOG_LEVEL=info
